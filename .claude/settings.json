{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "defaultMode": "acceptEdits",
        "allow": [
            "Read",
            "Glob",
            "Grep",
            "Edit",
            "Write",
            "WebFetch(domain:laravel.com)",
            "WebFetch(domain:inertiajs.com)",
            "WebFetch(domain:react.dev)",
            "WebFetch(domain:tailwindcss.com)",
            "WebFetch(domain:php.net)",
            "WebSearch",

            "Bash(ls:*)",
            "Bash(cat:*)",
            "Bash(head:*)",
            "Bash(tail:*)",
            "Bash(find:*)",
            "Bash(grep:*)",
            "Bash(rg:*)",
            "Bash(wc:*)",
            "Bash(sed -n:*)",
            "Bash(diff:*)",
            "Bash(mkdir:*)",
            "Bash(cp:*)",
            "Bash(mv:*)",
            "Bash(touch:*)",

            "Bash(php artisan:*)",
            "Bash(php -v)",
            "Bash(php -r:*)",
            "Bash(herd php:*)",
            "Bash(herd:*)",

            "Bash(composer install)",
            "Bash(composer update:*)",
            "Bash(composer require:*)",
            "Bash(composer dump-autoload:*)",
            "Bash(composer run:*)",
            "Bash(composer test)",
            "Bash(composer lint)",
            "Bash(composer lint:check)",
            "Bash(composer types:check)",
            "Bash(composer ci:check)",
            "Bash(./vendor/bin/pint:*)",
            "Bash(vendor/bin/pint:*)",
            "Bash(./vendor/bin/phpstan:*)",
            "Bash(vendor/bin/phpstan:*)",
            "Bash(./vendor/bin/phpunit:*)",
            "Bash(vendor/bin/phpunit:*)",

            "Bash(npm run:*)",
            "Bash(npm install)",
            "Bash(npm install:*)",
            "Bash(npm ci)",
            "Bash(npm ls:*)",
            "Bash(npx tsc:*)",
            "Bash(npx vp:*)",
            "Bash(node:*)",

            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git branch:*)",
            "Bash(git add:*)",
            "Bash(git restore:*)",
            "Bash(git stash list)",
            "Bash(gh pr view:*)",
            "Bash(gh pr list:*)",
            "Bash(gh run list:*)",
            "Bash(gh run view:*)"
        ],
        "ask": [
            "Bash(git push:*)",
            "Bash(git commit:*)",
            "Bash(git reset:*)",
            "Bash(git checkout:*)",
            "Bash(gh pr create:*)",
            "Bash(php artisan migrate:fresh:*)",
            "Bash(php artisan migrate:refresh:*)",
            "Bash(php artisan migrate:reset:*)",
            "Bash(php artisan db:wipe:*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./auth.json)",
            "Read(./storage/*.key)",
            "Edit(./.env)",
            "Edit(./.env.*)",
            "Edit(./vendor/**)",
            "Edit(./node_modules/**)",
            "Edit(./public/build/**)",
            "Bash(rm -rf:*)",
            "Bash(git push --force:*)",
            "Bash(git push -f:*)",
            "Bash(git clean:*)"
        ]
    }
}
